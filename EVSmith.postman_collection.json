    {"name":"Verify OTP","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"demo@evsmith.in\",\"otp\":\"123456\"}"},"url":"{{base}}/auth/verify-otp"}},
    {"name":"Admin Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"admin@evsmith.in\",\"password\":\"admin123\"}"},"url":"{{base}}/auth/admin-login"}},
    {"name":"Bikes","request":{"method":"GET","url":"{{base}}/bikes"}},
    {"name":"Rentals","request":{"method":"GET","url":"{{base}}/rentals"}},
    {"name":"Payments","request":{"method":"GET","url":"{{base}}/payments"}}
